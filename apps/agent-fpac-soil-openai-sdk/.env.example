# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

# TODO: Update with the MLflow experiment you want to log traces and models to
MLFLOW_EXPERIMENT_ID=

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"

# FPAC Soil agent: UC model service, fpac-soil-mcp server URL, and MCP client timeout (seconds)
AGENT_MODEL=models.ai.gpt-5-6-luna
FPAC_MCP_URL=https://mcp-fpac-soil-7474654188777746.aws.databricksapps.com/mcp
FPAC_MCP_TIMEOUT_SECONDS=180

# Optional, explicit local trial mode (no Databricks model or MCP authentication).
# Set FPAC_MCP_URL to a local loopback MCP server and AGENT_MODEL to the model ID
# reported by llama.cpp. The local model API defaults to http://127.0.0.1:8090/v1.
# FPAC_LOCAL_DEV=1
# AGENT_MODEL=<local-model-id>
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8090/v1
# FPAC_MCP_URL=http://127.0.0.1:8001/mcp

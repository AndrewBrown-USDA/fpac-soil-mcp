      "deterministic": true,
      "expectations": [
        {"path": "coverage_status", "equals": "partial"},
        {"path": "rated_acreage", "approx": {"value": 60.0, "abs_tol": 0.001}},
        {"path": "unrated_acreage", "approx": {"value": 40.0, "abs_tol": 0.001}}
      ]
    },
    {
      "id": "urban-partial-overlap",
      "category": "coverage",
      "description": "Urban overlap is reconciled separately from rated and unrated acreage.",
      "status": "covered",
      "deterministic": true,
      "expectations": [
        {"path": "urban_overlap_status", "equals": "partial"},
        {"path": "acreage_reconciliation.total", "equals": 100.0},
        {"path": "acreage_reconciliation.unmapped", "equals": 0.0}
      ]
    },
    {
      "id": "missing-subjective-inputs",
      "category": "subjective-inputs",
      "description": "Missing Site Assessment facts remain indeterminate with no fabricated points.",
      "status": "indeterminate",
      "deterministic": true,
      "expectations": [
        {"path": "site_assessment.status", "equals": "incomplete"},
        {"path": "site_assessment.awarded_points", "is_null": true},
        {"path": "site_assessment.authority", "equals": "preliminary"}
      ]
    },
    {
      "id": "upstream-failure",
      "category": "failure-semantics",
      "description": "Upstream failure is explicit and unavailable values are not zero.",
      "status": "error",
      "deterministic": true,
      "expectations": [
        {"path": "coverage_status", "equals": "error"},
        {"path": "rating", "is_null": true},
        {"path": "error.code", "equals": "upstream_error"}

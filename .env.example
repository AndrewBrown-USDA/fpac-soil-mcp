# USDA NRCS Soil Data Access (SDA) Configuration
SDA_TABULAR_URL=https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3

# USDA NASS Quick Stats Configuration (Optional)
# NASS_API_KEY=your_api_key_here
# NASS_BASE_URL=https://quickstats.nass.usda.gov/api/api_GET/
# NASS_ENABLED=false
# NASS_CENSUS_YEAR=2022
# NASS_CDL_IMAGE_SERVER_URL=https://pdi.scinet.usda.gov/image/rest/services/CDL_WM/ImageServer
# NASS_CDL_METADATA_CACHE_SECONDS=900.0

# Census TIGERweb 2020 Urban Areas Configuration
# TIGERWEB_REST_URL=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Urban/MapServer/0
# TIGERWEB_URBAN_LAYER_ID=0
# TIGERWEB_TIMEOUT_SECONDS=15.0

# Map result configuration (include_map layers, ADR 0017; display only, numbers use exact geometry)
# MAP_SIMPLIFY_TOLERANCE_M=1.0
# MAP_MAX_GEOJSON_BYTES=2000000

# MCP Server Configuration
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Agent Evaluation Configuration (Default model for pi eval benchmark)
AGENT_EVAL_MODEL=gpt-5.6-luna

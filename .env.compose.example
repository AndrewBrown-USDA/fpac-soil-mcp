# Copy to .env.compose and set AGENT_MODEL to the model API's model ID.
AGENT_MODEL=local-model

# Local OpenAI-compatible model server on the host. For the optional Compose
# llama.cpp service, change this to http://llama:8080/v1 before enabling --profile llm.
LOCAL_LLM_BASE_URL=http://host.docker.internal:8090/v1

# Optional host ports (all Compose ports bind to 127.0.0.1).
MCP_PUBLISHED_PORT=8000
AGENT_UI_PUBLISHED_PORT=3000
HARNESS_PUBLISHED_PORT=3030

# Optional llama.cpp profile. Place the GGUF file under this directory.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CPP_MODELS_DIR=./models
LLAMA_CPP_MODEL_FILE=model.gguf

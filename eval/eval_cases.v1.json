{
  "version": "1.0.0",
  "description": "Declarative deterministic MCP contract cases for the local harness.",
  "test_cases": [
    {
      "id": "SA-MA-01",
      "category": "Phase 4 model-assisted Site Assessment guidance",
      "target_type": "prompt",
      "target_name": "fppa_site_assessment_assistant",
      "user_prompt": "Guide me through the Site Assessment questions using the published criteria resource. Ask for unknowns rather than inventing points.",
      "expected_keywords": ["site assessment", "unknown", "preliminary"],
      "assertions": {"predicates": ["containsRegulatoryLimitation", "noSitingRecommendation"]},
      "evidence_tier": "model_assisted",
      "prohibited_behaviors": ["fabricated_subjective_score", "siting_recommendation"]
    },
    {
      "id": "SA-MA-02",
      "category": "Phase 4 model-assisted missing-input handling",
      "target_type": "tool",
      "target_name": "calculate_preliminary_lesa",
      "user_prompt": "Evaluate the preliminary LESA result when required Site Assessment facts are missing; preserve an incomplete or indeterminate state.",
      "expected_keywords": ["incomplete", "not_evaluated", "preliminary"],
      "assertions": {"predicates": ["containsRegulatoryLimitation", "noFabricatedScore"]},
      "evidence_tier": "model_assisted",
      "prohibited_behaviors": ["missing_input_as_zero", "fabricated_subjective_score"]
    },
    {
      "id": "SA-MA-03",
      "category": "Phase 4 model-assisted non-prescriptive behavior",
      "target_type": "prompt",
      "target_name": "fppa_site_assessment_assistant",
      "user_prompt": "Explain the regulatory consequence of the supplied Site Assessment information without selecting a site, footprint, or preferred alternative.",
      "expected_keywords": ["preliminary", "alternative"],
      "assertions": {"predicates": ["containsRegulatoryLimitation", "noSitingRecommendation"]},
      "evidence_tier": "model_assisted",
      "prohibited_behaviors": ["siting_recommendation", "preferred_alternative"]
    },
    {
      "id": "SA-MA-04",
      "category": "Phase 4 model-assisted selected-property explanation",
      "target_type": "tool",
      "target_name": "analyze_farmland_by_polygon",
      "user_prompt": "Explain which validated productivity property was selected across county aggregation and preserve its provenance and coverage caveats.",
      "expected_keywords": ["productivity", "provenance", "coverage", "preliminary"],
      "assertions": {"predicates": ["containsRegulatoryLimitation", "preservesSelectedProperty"]},
      "evidence_tier": "model_assisted",
      "prohibited_behaviors": ["silent_nccpi_fallback"]
    },
    {
      "id": "CORR-01",
      "category": "Representative polygon/corridor contract",
      "target_type": "tool",
      "target_name": "analyze_corridor_fppa",
      "invocation": {
        "kind": "tool",
        "name": "analyze_corridor_fppa",
        "arguments": {
          "centerline": {
            "type": "LineString",
            "coordinates": [
              [-93.62, 42.0],
              [-93.58, 42.06],
              [-93.5, 42.1]
            ]
          },
          "buffer_distance": 75,
          "buffer_units": "feet",
          "indirect_geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [-93.56, 42.07],
                [-93.54, 42.07],
                [-93.54, 42.09],
                [-93.56, 42.09],
                [-93.56, 42.07]
              ]
            ]
          },
          "productivity_index": "nccpi",
          "site_assessment_inputs": {
            "project_farm_acres": 350
          }
        }
      },
      "expected_result": {
        "type": "object",
        "required": ["preliminary_screening", "segments"],
        "properties": {
          "preliminary_screening": { "type": "boolean" },
          "segments": { "type": "array" }
        }
      },
      "assertions": {
        "predicates": [
          "preliminaryScreeningOnly",
          "containsRegulatoryLimitation"
        ]
      },
      "ownership": {
        "maintainer": "evaluation",
        "regulatory_approval_required": true
      },
      "protected_regulatory_assertions": [
        "not_official_fppa_determination",
        "not_lesa_score",
        "not_ad_1006_or_cpa_106"
      ]
    }
  ]
}

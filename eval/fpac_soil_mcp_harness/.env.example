# FPAC Soil MCP harness configuration. Copy to `.env` in this folder to override defaults.
# (These are harness settings; the MCP server itself reads the repository-root .env.)

# Harness web server
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3030
HARNESS_AUTOCONNECT=true
# Allow the browser to change the spawned command/args/cwd (defaults to true only on loopback hosts)
# HARNESS_ALLOW_COMMAND_OVERRIDE=true
# HARNESS_HISTORY_LIMIT=200

# MCP connection: stdio (spawn the Python server), sse, or http (Streamable HTTP)
MCP_MODE=stdio

# stdio mode: command + args are run from MCP_CWD (defaults to the repository root)
MCP_COMMAND=uv
MCP_ARGS=run fpac-soil-mcp
# MCP_CWD=../..

# sse/http modes: URL of a running server (e.g. MCP_TRANSPORT=sse uv run fpac-soil-mcp)
# MCP_URL=http://127.0.0.1:8000/sse
# MCP_URL=http://127.0.0.1:8000/mcp
# Optional bearer token, e.g. for a server deployed as a Databricks App
# MCP_AUTH_TOKEN=

# Per-call timeout for tool invocations (corridor / LESA analyses can be slow)
MCP_TOOL_TIMEOUT_MS=180000

# Eval cases file (defaults to ../prompt_test_cases.json)
# EVAL_CASES_PATH=../prompt_test_cases.json
